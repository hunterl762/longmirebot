# Discord bot token from the Discord Developer Portal
BOT_TOKEN=

# Discord application credentials used for dashboard OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Exact callback URL configured in Discord OAuth2 Redirects
# Example: http://localhost:3000/auth/discord/callback
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Public dashboard base URL (used for links/status output)
DASHBOARD_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Prefix used until a server changes it in the dashboard
DEFAULT_PREFIX=?

# Optional: Discord user ID that may run owner-only commands such as set-stream/webhook
BOT_OWNER_ID=

# Optional: webhook URL used by the disabled-by-default webhook command.
# Never commit a real webhook URL/token to GitHub.
OWNER_WEBHOOK_URL=
